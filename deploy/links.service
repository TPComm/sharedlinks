# /etc/systemd/system/links.service — the Links API, behind Caddy on 127.0.0.1:8000.
[Unit]
Description=Links API
After=network-online.target
Wants=network-online.target

[Service]
User=links
Group=links
WorkingDirectory=/var/lib/links
EnvironmentFile=/etc/links/links.env
Environment=HOST=127.0.0.1 PORT=8000 DATA_DIR=/var/lib/links
ExecStart=/opt/links/links-server
Restart=always
RestartSec=2

# The box is small: cap memory so a runaway preview fetch can't take SSH down with it.
MemoryMax=300M

# Hardening. (No MemoryDenyWriteExecute: Bun's JIT needs writable+executable pages.)
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/links
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
# AF_NETLINK: glibc DNS lookups enumerate interfaces over netlink.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
