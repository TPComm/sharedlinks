// Settings for all three targets. Change these, not the project file.

// Your Apple Developer team (Xcode > Settings > Accounts). Needed for a real device.
DEVELOPMENT_TEAM =

// Base bundle id. The Share Extension and widgets append .share / .widgets, and the
// App Group is group.$(LINKS_BUNDLE_ID). Use something you own, e.g. com.yourname.links.
LINKS_BUNDLE_ID = com.example.links

// Where server/ runs. The Simulator can use localhost; a phone needs your VPS's https URL.
// ("//" starts a comment in xcconfig files, hence the $() in the middle.)
LINKS_SERVER_URL = http:/$()/localhost:8000

// Where people reach whoever runs the server (App Store guideline 1.2), shown in the account menu
// and on the sign-in screen: a mailto: address, or an https: page (written https:/$()/...).
// Use the same address as the server's SUPPORT_EMAIL, which its /support page shows.
LINKS_SUPPORT_URL = mailto:support@example.com
