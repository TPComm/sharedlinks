// Settings for all targets. Change these, not the project file.

// Apple Developer team that owns the app in App Store Connect. Only device and archive builds
// use it; Simulator builds sign ad hoc.
DEVELOPMENT_TEAM = 9F2D9SPG9Z

// Base bundle id, registered in App Store Connect. The extensions append
// .share / .widgets / .messages / .notifications, and the App Group is group.$(LINKS_BUNDLE_ID).
// A fork that ships its own build sets its own team and something it owns here,
// e.g. com.yourname.links.
LINKS_BUNDLE_ID = com.tpcomm.links

// The version people see, and the build number App Store Connect needs to be higher than the
// last upload of that version. The app and its extensions must match, so they live here once.
MARKETING_VERSION = 2.0
CURRENT_PROJECT_VERSION = 14

// Where server/ runs: Debug builds (the Simulator, UI tests) use a local server, Release builds
// (archives for TestFlight and the App Store) the production one.
// ("//" starts a comment in xcconfig files, hence the $() in the middle.)
LINKS_SERVER_URL_Debug = http:/$()/localhost:8000
LINKS_SERVER_URL_Release = https:/$()/links.tpcomm.co
LINKS_SERVER_URL = $(LINKS_SERVER_URL_$(CONFIGURATION))

// Where people reach whoever runs the server (App Store guideline 1.2), shown in the profile
// and on the sign-in screen: a mailto: address, or an https: page (written https:/$()/...).
// Use the same address as the server's SUPPORT_EMAIL, which its /support page shows.
LINKS_SUPPORT_URL = mailto:support@tpcomm.co

// The server's host name, without https:// or a port. Its https://HOST/l/, /invite/ and /g/ links
// open the app (universal links), once the server sets APPLE_APP_IDS. Needs a paid Apple Developer
// team. Debug builds add ?mode=developer, which reads the file straight from the server instead of
// Apple's cache (turn on Settings > Developer > Associated Domains Development on the phone).
LINKS_ASSOCIATED_DOMAIN = links.tpcomm.co
LINKS_ASSOCIATED_DOMAIN_MODE[config=Debug] = ?mode=developer

// The AuthKit custom domain (WorkOS dashboard > Domains), where the sign-in page lives. Passwords
// are saved under this host, so it needs an apple-app-site-association file with a webcredentials
// entry for the app; WorkOS serves that host, not this server.
LINKS_AUTH_DOMAIN = auth.tpcomm.co
