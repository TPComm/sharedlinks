<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications. Xcode swaps in "production" when it signs for TestFlight and the App Store. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Shared by the app, Share Extension and widgets: the session keychain item
	     (an App Group id doubles as a keychain access group), the inbox cache and thumbnails. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.$(LINKS_BUNDLE_ID)</string>
	</array>
	<!-- App only, not the extensions: https://HOST/l/, /invite/ and /g/ open Links (universal links),
	     and the server's sign-in can use its passwords. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:$(LINKS_ASSOCIATED_DOMAIN)$(LINKS_ASSOCIATED_DOMAIN_MODE)</string>
		<string>webcredentials:$(LINKS_ASSOCIATED_DOMAIN)$(LINKS_ASSOCIATED_DOMAIN_MODE)</string>
	</array>
	<!-- New-link pushes show the sender's photo, as messages do (LinksNotifications). -->
	<key>com.apple.developer.usernotifications.communication</key>
	<true/>
</dict>
</plist>
