<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared by the app, Share Extension and widgets: the session keychain item
	     (an App Group id doubles as a keychain access group), the inbox cache and thumbnails. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.$(LINKS_BUNDLE_ID)</string>
	</array>
</dict>
</plist>
